# Contact
CHURCH_NOTIFICATION_EMAIL=larencontrefr@gmail.com

# Google Sheets Write (Service Account)
# Create a service account at https://console.cloud.google.com
# Enable Google Sheets API, create key, paste full JSON here
GOOGLE_SERVICE_ACCOUNT_JSON={}

# Reservations Sheet
SHEET_ID_RESERVATIONS=
